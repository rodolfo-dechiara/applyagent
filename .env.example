# ApplyAgent environment configuration. Copy to .env and edit.
# Only DJANGO_SECRET_KEY is expected in production; MISTRAL_API_KEY is optional:
# without it the app runs fully in demo mode with "DEMO OUTPUT: ..." placeholders.

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. When unset, no network calls are made and the agent returns
# deterministic, clearly-marked demo output instead.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT=60
