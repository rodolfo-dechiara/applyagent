# You're Hired environment configuration. Copy to .env and edit.
# Only DJANGO_SECRET_KEY is expected in production; MISTRAL_API_KEY is optional:
# without it the app runs fully in demo mode with "DEMO OUTPUT: ..." placeholders.

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. When unset, no network calls are made and the agent returns
# deterministic, clearly-marked demo output instead.
MISTRAL_API_KEY=

# Feature flag: when true, the public job board (/jobs/) is seeded with
# clearly-marked fake "DEMO POSTING" entries for demos. Off by default.
APPLYAGENT_DEMO_JOBS=false
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT=60

# Outbound email (verification links, password reset). When EMAIL_HOST is unset,
# emails are printed to stdout (console backend) instead of being sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="You're Hired <noreply@youre-hired.eu>"

# Rate limiting (fixed window; login is also keyed per account).
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_RESEND_ATTEMPTS=3
