# Relay-only Postfix for You're Hired (youre-hired.eu) on Fly's private 6PN.
# No public inbound: the app has no [services], so no inbound ports are open;
# the dedicated IPv4 is used for egress only (SPF ip4 + PTR-friendly HELO).

# Log to stdout so `fly logs` captures everything.
maillog_file = /dev/stdout

# HELO identity for outbound SMTP; mail.youre-hired.eu must have an A record
# pointing at this app's dedicated IPv4.
myhostname = mail.youre-hired.eu
mydomain = youre-hired.eu
myorigin = $mydomain
inet_interfaces = all
inet_protocols = all
mydestination = $myhostname, localhost.$mydomain, localhost

# Trust only the Fly private network (fdaa::/8 6PN + container-local ranges)
# and localhost; relay for those, reject everything else (no open relay).
# NOTE: Postfix requires brackets for IPv6 blocks here, and the canonical
# network form (zeroed host bits): [fd00::]/8 covers the whole Fly 6PN ULA
# range, including fdaa::/8.
mynetworks = 127.0.0.0/8 [::1]/128 172.16.0.0/12 [fd00::]/8
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_helo_required = yes
smtpd_client_connection_count_limit = 20

# DKIM-sign outbound mail (opendkim on 127.0.0.1:8891; key from the
# DKIM_PRIVATE_KEY secret). If the milter is down, accept and send unsigned
# rather than dropping the app's verification emails.
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = inet:127.0.0.1:8891
milter_default_action = accept
milter_protocol = 6

# Outbound: opportunistic TLS, deliver straight to the recipient's MX.
smtp_tls_security_level = may
smtp_tls_note_starttls_offer = yes
# MX lookups go through the local DoH bridge (see entrypoint.sh / dnsbridge.py).
# Prefer IPv4 for outbound SMTP: Fly IPv6 egress on port 25 is unreliable.
smtp_address_preference = ipv4
message_size_limit = 10485760

# Small demo queue.
queue_run_delay = 30s
maximal_queue_lifetime = 1d
